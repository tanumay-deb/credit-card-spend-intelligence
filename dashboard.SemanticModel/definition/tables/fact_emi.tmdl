	partition fact_emi = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(ProjectFolder & "\output\emi_plans.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"start_date", type date}, {"end_date", type date}, {"principal", type number}, {"tenure_months", Int64.Type}, {"remaining_months", Int64.Type}, {"interest_rate", type number}, {"instalment_amount", type number}, {"interest_payable", type number}, {"outstanding", type number}})
				in
					Typed

