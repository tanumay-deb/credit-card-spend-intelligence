table fact_emi
	lineageTag: b392f423-690c-463b-bc2d-6c566b027ff7

	/// Instalment plans still running, as each statement reports them. HDFC
	/// prints a rate and the interest still payable but no finish date; ICICI
	/// prints a finish date and the instalment amount but no rate. Those gaps
	/// are what the issuer omits, not what the parser missed.
	measure 'EMI Plans' = CALCULATE(COUNTROWS(fact_emi), fact_emi[status] = "active")
		formatString: #,0
		lineageTag: 49f3e812-963e-4804-a535-b15364f463f4

	measure 'EMI Outstanding' = CALCULATE(SUM(fact_emi[outstanding]), fact_emi[status] = "active")
		formatString: \₹#,0;-\₹#,0;\₹#,0
		lineageTag: 46048521-3c3a-40be-8daa-bdf11b27c901

	measure 'EMI Principal' = CALCULATE(SUM(fact_emi[principal]), fact_emi[status] = "active")
		formatString: \₹#,0;-\₹#,0;\₹#,0
		lineageTag: 39db8d01-2075-471b-a8b6-7bbeb225bfb2

	/// Longest run still to go -- how long until this commitment is clear.
	measure 'EMI Months Left' = CALCULATE(MAX(fact_emi[remaining_months]), fact_emi[status] = "active")
		formatString: #,0
		lineageTag: 2edd6e98-37b3-4550-9024-21ecfa9adf5d

	measure 'EMI Interest Payable' = CALCULATE(SUM(fact_emi[interest_payable]), fact_emi[status] = "active")
		formatString: \₹#,0;-\₹#,0;\₹#,0
		lineageTag: 14fcbb92-6787-42a9-80fd-ec8aae48db2a

	measure 'EMI Monthly Instalment' = CALCULATE(SUM(fact_emi[instalment_amount]), fact_emi[status] = "active")
		formatString: \₹#,0;-\₹#,0;\₹#,0
		lineageTag: 3d07d8c0-4313-4588-9672-2ecf09695571

