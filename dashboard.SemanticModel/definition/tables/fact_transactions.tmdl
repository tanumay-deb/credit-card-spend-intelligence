	partition fact_transactions = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(ProjectFolder & "\output\transactions.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Blanked = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, {"spend_amount"}),
					Typed = Table.TransformColumnTypes(Blanked, {{"txn_date", type date}, {"amount", type number}, {"spend_amount", type number}})
				in
					Typed

	annotation PBI_ResultType = Table

