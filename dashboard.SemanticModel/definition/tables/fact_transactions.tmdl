table fact_transactions
	lineageTag: 373245d7-851e-4f7f-b94c-fc949a372a17

	/// Spend as billed: charges add, refunds subtract, and payments, cashback and
	/// returned autopays count nothing. The rules live in creditcard/spend.py and
	/// arrive as spend_amount, so an EMI purchase and its conversion credit net to
	/// zero and only the monthly instalments remain.
	measure 'Total Spend' = SUM(fact_transactions[spend_amount])
		formatString: \₹#,0;-\₹#,0;\₹#,0
		lineageTag: ebf6d89b-c981-4b2a-8bb5-05a2b7d41f08

	measure Transactions = CALCULATE(COUNTROWS(fact_transactions), fact_transactions[spend_amount] > 0)
		formatString: #,0
		lineageTag: 8c36dede-58c7-4db0-b3a5-fca3d53a8b3e

	measure 'Avg Transaction' = DIVIDE(CALCULATE(SUM(fact_transactions[spend_amount]), fact_transactions[spend_amount] > 0), [Transactions])
		formatString: \₹#,0;-\₹#,0;\₹#,0
		lineageTag: 85a22995-e98a-4a71-9b76-9673cea6af0e

	/// Uncategorised means not yet known, and is deliberately distinct from
	/// Others/Misc, which is a decision someone made. Only this is a backlog.
	measure 'Uncategorised %' = DIVIDE(CALCULATE([Total Spend], fact_transactions[subcategory] = "Uncategorised"), [Total Spend])
		formatString: 0.0%
		lineageTag: 0bc6312b-963c-45d6-b777-5e76224472ec

	/// Card charges -- fees, GST and interest on unpaid balances -- net of any
	/// reversal matched to them. EMI interest sits under EMI.
	measure 'Interest & Fees' = CALCULATE([Total Spend], fact_transactions[subcategory] = "Fees & Interest")
		formatString: \₹#,0;-\₹#,0;\₹#,0
		lineageTag: e74bc52b-0f5f-4dbd-a008-6c6379310399

	measure 'Number of Cards' = CALCULATE(DISTINCTCOUNT(fact_transactions[card_id]), dim_card[closed] <> "yes")
		formatString: #,0
		lineageTag: 79191b23-0716-4c28-afc1-d538664b0300

	/// The most recent statement date held. Spend after this date is not in the
	/// data at all, so the latest cycle always reads low until its PDF arrives.
	measure 'Billed Through' = MAX(fact_statements[statement_date])
		lineageTag: a42236dd-15b8-4500-abe5-811256f44eb1

	/// Light green for money coming in. Blank for debits, which leaves them
	/// uncoloured instead of giving them a colour of their own.
	measure 'Credit Row Colour' = IF(SELECTEDVALUE(fact_transactions[direction]) = "credit", "#C6EFCE")

	/// Rewards credited back. Kept out of Total Spend: cashback is not a refund of
	/// anything bought.
	measure 'Cashback Earned' = CALCULATE(SUM(fact_transactions[amount]), fact_transactions[txn_type] = "cashback")
		formatString: \₹#,0;-\₹#,0;\₹#,0

	/// Total Spend on purchases and their refunds only, so a merchant ranking is not
	/// topped by EMI instalments, fees or GST lines.
	measure 'Merchant Spend' = CALCULATE([Total Spend], fact_transactions[txn_type] IN {"purchase", "refund"})
		formatString: \₹#,0;-\₹#,0;\₹#,0

