table fact_statements
	lineageTag: 2ead3349-a2b1-4509-9746-f2931c06947d

	/// Each card's balance on its latest statement in the selected period -- with no
	/// month picked, the current bill. Summing every statement in the period counted
	/// the same debt once a month, so a year of statements read about twelve times
	/// the balance and utilisation passed 100%. A payment made since that statement
	/// only shows once the next statement arrives.
	measure 'Current Outstanding' = SUMX(VALUES(fact_statements[card_id]), VAR latest = CALCULATE(MAX(fact_statements[statement_date])) RETURN CALCULATE(SUM(fact_statements[total_due]), fact_statements[statement_date] = latest))
		formatString: \₹#,0;-\₹#,0;\₹#,0
		lineageTag: 43ea417c-4afd-4828-bad7-1b49fea57fad

	/// Minimum due on each card's latest statement in the selected period, for the
	/// same reason as Current Outstanding.
	measure 'Minimum Due' = SUMX(VALUES(fact_statements[card_id]), VAR latest = CALCULATE(MAX(fact_statements[statement_date])) RETURN CALCULATE(SUM(fact_statements[min_due]), fact_statements[statement_date] = latest))
		formatString: \₹#,0;-\₹#,0;\₹#,0
		lineageTag: f3376ffc-b920-46c2-afec-55cdbf98c85a

	/// Read from dim_card, so it is immune to date filtering. A credit limit is
	/// not a monthly quantity.
	measure 'Total Credit Limit' = SUMX(VALUES(dim_card[limit_group]), CALCULATE(MAX(fact_statements[credit_limit])))
		formatString: \₹#,0;-\₹#,0;\₹#,0
		lineageTag: 8eb3432e-1b83-498f-8cf7-ef7266d16321

	/// Headroom left on each credit limit. Cards sharing a limit draw on it together,
	/// so their headroom is the shared limit less what every card on it owes.
	measure 'Available Credit' = SUMX(VALUES(dim_card[limit_group]), CALCULATE(MAX(fact_statements[credit_limit])) - CALCULATE([Current Outstanding], ALLEXCEPT(dim_card, dim_card[limit_group])))
		formatString: \₹#,0;-\₹#,0;\₹#,0
		lineageTag: 7650e9dd-2747-4cb3-9baf-ca8d26e21fbc

	/// Divides portfolio totals. Averaging per-card ratios answers a different
	/// question and gives a different number. Cards sharing a limit are measured
	/// against it together, as the issuer counts their balances jointly.
	measure 'Utilisation %' = DIVIDE(SUMX(VALUES(dim_card[limit_group]), CALCULATE([Current Outstanding], ALLEXCEPT(dim_card, dim_card[limit_group]))), [Total Credit Limit])
		formatString: 0.0%
		lineageTag: 23137314-d30b-4ac2-82f3-e964314fa76b

