# Copy this file to config/secrets.env and fill in this PC's settings.
# config/secrets.env is git-ignored; this .example file is not, and must
# never contain a real password.
#
# Passwords are kept in Windows Credential Manager, not here. Leave the
# password lines blank and store each password with
#     .venv\Scripts\python.exe -m creditcard.vault set NAME
# and `python -m creditcard.vault check` shows which are stored. A password
# written here would still work, and would win - but it would sit in plain text.
#
# The names come from the password_env column in cards.csv, plus
# EMAIL_PASSWORD. Most Indian issuers use a formula such as the first four
# letters of your name in caps plus DDMM of your birth date -- check the
# covering email.

HDFC_MILLENNIA_PDF_PASSWORD=
HDFC_REGALIA_PDF_PASSWORD=
ICICI_PDF_PASSWORD=
SBI_ELITE_PDF_PASSWORD=
SBI_BPCL_PDF_PASSWORD=

# Email statement download credentials (IMAP over SSL)
# For Gmail, EMAIL_PASSWORD is an App Password (Google Account -> Security ->
# 2-Step Verification -> App Passwords), stored with `vault set EMAIL_PASSWORD`.
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=
# The daily check's alerts go out through Gmail's SMTP server with the same app
# password. Set these only for a different mail provider:
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# Can be a single folder (INBOX) or multiple comma-separated folders:
# EMAIL_FOLDERS=INBOX, "Bank Statements", "[Gmail]/All Mail"
EMAIL_FOLDER=INBOX

# Where the daily check backs up statements/ and config/ (never secrets.env or
# output/), separated by ";". A folder on a missing drive is skipped and reported.
# BACKUP_DIRS=C:\Users\you\OneDrive\Backups\CreditCard;E:\Backups\CreditCard
